# Chess Platform Local Development Environment Variables
# ─────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Generate real values using:  just secrets-init
# 3. NEVER commit .env to version control.
#
# All values below are PLACEHOLDERS — they will NOT work as-is.

POSTGRES_USER=<generate-me>
POSTGRES_PASSWORD=<generate-me>
POSTGRES_DB=<generate-me>
JWT_SECRET=<generate-me>
