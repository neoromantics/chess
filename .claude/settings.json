{
  "permissions": {
    "allow": [
      "Bash(go *)",
      "Bash(gofmt *)",
      "Bash(goimports *)",
      "Bash(golangci-lint *)",
      "Bash(staticcheck *)",
      "Bash(govulncheck *)",
      "Bash(dlv *)",
      "Bash(just *)",
      "Bash(make *)",
      "Bash(curl http://localhost:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -X * http://localhost:*)",
      "Bash(curl --data-binary * http://localhost:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c \"import sys,json; d=json.load(sys.stdin); print(d.get('tool_input',{}).get('file_path',''))\" | { read -r f; case \"$f\" in *.go) gofmt -w \"$f\" 2>/dev/null || true ;; esac; }",
            "statusMessage": "gofmt"
          }
        ]
      }
    ]
  }
}
